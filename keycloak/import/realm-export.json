{
  "id": "event-realm",
  "realm": "event-realm",
  "loginTheme": "event-theme",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrator role"
      },
      {
        "name": "COMPANY_USER",
        "description": "Company Representative role"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "company",
      "email": "company@example.com",
      "enabled": true,
      "firstName": "Company",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "company",
          "temporary": false
        }
      ],
      "realmRoles": [
        "COMPANY_USER"
      ]
    },
    {
      "username": "student",
      "email": "student@example.com",
      "enabled": true,
      "firstName": "Student",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "student",
          "temporary": false
        }
      ],
      "realmRoles": []
    }
  ],
  "clients": [
    {
      "clientId": "frontend-app",
      "enabled": true,
      "secret": "***ENTFERNT***",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3000/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "frontend-app",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
